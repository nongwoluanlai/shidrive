{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiDrive",
  "version": "0.3.1",
  "identifier": "com.shidrive.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "使驾 ShiDrive",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 660,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
